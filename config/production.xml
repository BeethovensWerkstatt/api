<?xml version="1.0" encoding="UTF-8"?>
<!--
    Production Environment Configuration
    
    This file contains settings for the production deployment.
    It is loaded by config.xqm based on the BW_ENV system property.
-->
<config xmlns="https://api.beethovens-werkstatt.de/config">
    <!-- Base URI for API endpoints -->
    <baseUri>https://api.beethovens-werkstatt.de</baseUri>
    
    <!-- CORS configuration -->
    <cors enabled="true">
        <allowOrigin>https://beethovens-werkstatt.de, https://dev.beethovens-werkstatt.de</allowOrigin>
        <allowMethods>GET, OPTIONS</allowMethods>
        <allowHeaders>Content-Type</allowHeaders>
    </cors>
    
    <!-- Debug settings -->
    <debug enabled="false">
        <logLevel>warn</logLevel>
        <showStackTrace>false</showStackTrace>
    </debug>
    
    <!-- Cache settings -->
    <cache enabled="true">
        <ttl>3600</ttl>
    </cache>
    
    <!-- Data repositories -->
    <dataRepos>
        <repo name="data" branch="main" autoUpdate="false"/>
        <repo name="data-cache" branch="main" autoUpdate="false"/>
    </dataRepos>
    
    <!-- API versioning -->
    <api>
        <prefix>/api</prefix>
        <defaultVersion>1</defaultVersion>
    </api>
</config>
