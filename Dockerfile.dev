# Development Dockerfile with eXist-DB apps accessible
# Keeps /exist context path but makes all apps available

FROM stadlerpeter/existdb:6.4.0-jre17

# Development mode with all default apps
ENV EXIST_ENV="development"
ENV EXIST_CONTEXT_PATH="/exist"
# No EXIST_DEFAULT_APP_PATH - keeps all apps accessible

# Set password for development
ENV EXIST_PASSWORD="admin123"

WORKDIR /opt/exist

# For local development, mount the package instead of copying:
# docker run -v $(pwd)/dist/api-*.xar:/opt/exist/autodeploy/api.xar ...
# Or copy it for a self-contained dev image:
# COPY dist/api-*.xar ${EXIST_HOME}/autodeploy/

# Expose standard ports
EXPOSE 8080 8443

# Use the base image's entrypoint (no custom cleanup needed for dev)
